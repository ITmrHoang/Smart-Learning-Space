# Cấu hình triển khai CHO MỘT MÁY. Mỗi máy chép thành `deploy/.env` rồi sửa (file .env không commit).
# Mọi máy dùng chung project + chung deploy/docker-compose.yml; chỉ file này khác nhau.
#
# Mật khẩu / secret: chỉ dùng chữ và số (vì được ghép vào URL kết nối). Sinh ngẫu nhiên:
#   openssl rand -hex 24
# Các máy dùng CHUNG mật khẩu Postgres / Valkey / RabbitMQ và JWT_SECRET.

# ─── 1. Máy này chạy những service nào ────────────────────────────────────────
# Một máy (tất cả):     postgres,valkey,rabbitmq,garage,livekit,api,worker,caddy
# Hai máy, ví dụ:
#   Máy A (chính):      postgres,valkey,rabbitmq,garage,livekit,api,worker,caddy
#   Máy B (xử lý nặng): worker            (sau này: import-worker, media-worker, ai-service…)
COMPOSE_PROFILES=postgres,valkey,rabbitmq,garage,livekit,api,worker,caddy

# ─── 2. Máy khác kết nối vào máy này qua IP nào ──────────────────────────────
# IP mạng LAN / VPN của CHÍNH máy này; cổng Postgres / Valkey / RabbitMQ mở trên IP đó.
# 127.0.0.1 = chỉ máy này dùng (chạy một máy). KHÔNG điền IP public.
PUBLISH_IP=127.0.0.1
# Mở cổng api ra LAN chỉ khi Caddy chạy ở máy khác.
API_PUBLISH_IP=127.0.0.1
# Cổng mở ra trên máy này (đổi khi cổng mặc định đã bị chiếm).
POSTGRES_PUBLISH_PORT=5432
VALKEY_PUBLISH_PORT=6379
RABBITMQ_PUBLISH_PORT=5672
RABBITMQ_ADMIN_PORT=15672
API_PUBLISH_PORT=8080
GARAGE_PUBLISH_PORT=3900
LIVEKIT_PUBLISH_PORT=7880

# ─── 3. Service ở đâu ────────────────────────────────────────────────────────
# Cùng máy: để tên service + cổng mặc định. Ở máy khác: điền IP / tên máy (ví dụ 10.0.0.1 hoặc sls-main)
# và cổng *_PUBLISH_PORT của máy đó.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
VALKEY_HOST=valkey
VALKEY_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
API_HOST=api
API_PORT=8080
GARAGE_HOST=garage
GARAGE_PORT=3900
LIVEKIT_HOST=livekit
LIVEKIT_PORT=7880

# ─── 4. Mật khẩu hạ tầng ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-postgres
VALKEY_PASSWORD=change-me-valkey
RABBITMQ_PASSWORD=change-me-rabbitmq

# ─── 5. api ──────────────────────────────────────────────────────────────────
# Ít nhất 32 ký tự.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# Địa chỉ người dùng mở trang web (link trong email, redirect SSO).
APP_BASE_URL=https://hoc.example.com
# true khi chạy HTTPS. Thử trong LAN bằng http:// thì đặt false (không thì cookie đăng nhập không lưu).
COOKIE_SECURE=true
CORS_ORIGINS=
MAX_SESSIONS_PER_USER=2

# Admin đầu tiên: chỉ tạo khi hệ thống chưa có admin. Đăng nhập xong nên đổi mật khẩu.
# Mật khẩu 8–128 ký tự, có cả chữ và số.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_FULL_NAME="Quản trị viên"
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe12345

# Đăng nhập Google / Microsoft. Để trống = ẩn nút. Mặc định SSO_REDIRECT_BASE = APP_BASE_URL.
SSO_REDIRECT_BASE=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=common

# ─── 6. worker (gửi email) ───────────────────────────────────────────────────
# SMTP_TLS: starttls (cổng 587, phổ biến nhất) · tls (TLS ngay từ đầu, cổng 465) · none (không mã hóa, chỉ dùng Mailpit).
# Bỏ trống SMTP_PORT = cổng mặc định theo SMTP_TLS. Ví dụ Gmail: smtp.gmail.com, starttls, mật khẩu ứng dụng.
SMTP_TLS=starttls
SMTP_HOST=smtp.example.com
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Smart Learning Space <no-reply@example.com>"
# Chỉ cần khi máy chủ mail nội bộ dùng chứng chỉ do CA riêng cấp: đường dẫn file PEM TRONG container
# (thêm volume cho service worker, ví dụ `- ./certs:/certs:ro`, rồi đặt /certs/ca.pem).
SMTP_CA_FILE=

# ─── 6b. Garage (lưu file: ảnh trong bài, bài làm của học sinh) ──────────────
# Sau lần `docker compose up -d` đầu tiên chạy MỘT LẦN: sh deploy/garage/init.sh prod
# Sinh giá trị: GARAGE_RPC_SECRET / GARAGE_ADMIN_TOKEN: openssl rand -hex 32
#               S3_ACCESS_KEY_ID: echo GK$(openssl rand -hex 12)   ·   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
# Để trống S3_ACCESS_KEY_ID = tắt upload file (bỏ `garage` khỏi COMPOSE_PROFILES).
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dung lượng ổ đĩa dành cho Garage trên máy này. Bắt buộc sao lưu thư mục dữ liệu (volume garagedata).
GARAGE_CAPACITY=100G

# ─── 6c. LiveKit (phòng học trực tuyến: video, bảng thông minh, giơ tay…) ─────
# Đặt trên máy có IP public + băng thông tốt; mở 7881/tcp và 7882/udp ra Internet. Trình duyệt vào qua
# wss://<SITE_ADDRESS>/rtc (Caddy chuyển vào LiveKit). Để trống LIVEKIT_API_KEY = chỉ dùng link họp ngoài.
# Sinh khóa: LIVEKIT_API_KEY=sls · LIVEKIT_API_SECRET: openssl rand -hex 32 · LIVEKIT_KEYS="<key>: <secret>"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_KEYS=
# Bỏ trống = wss://<APP_BASE_URL>. LiveKit ở domain riêng thì điền, ví dụ wss://live.example.com
LIVEKIT_PUBLIC_URL=

# ─── 7. caddy ────────────────────────────────────────────────────────────────
# Tên miền (đã trỏ về IP public của máy chạy Caddy, mở cổng 80 + 443) → tự có HTTPS.
# Chưa có tên miền: SITE_ADDRESS=:80 và APP_BASE_URL=http://<IP máy này>, COOKIE_SECURE=false.
SITE_ADDRESS=hoc.example.com
# Cổng web mở trên máy này. Dùng HTTPS tự động thì phải giữ 80 và 443.
HTTP_PORT=80
HTTPS_PORT=443

# ─── Khác ────────────────────────────────────────────────────────────────────
SLS_VERSION=0.1.0
RUST_LOG=info,sqlx=warn
