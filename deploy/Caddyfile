# Caddy: phục vụ frontend (file tĩnh), chuyển /api/* sang service api và /files/* sang Garage.
# SITE_ADDRESS, API_UPSTREAM, GARAGE_UPSTREAM đặt trong deploy/docker-compose.yml (lấy từ deploy/.env).

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# File trên Garage (upload / tải bằng presigned URL do api ký). Giữ nguyên Host + đường dẫn để chữ ký khớp.
	# Kiểu file khi tải do api ép trong link (chỉ ảnh / PDF) nên Garage không trả được trang HTML.
	handle /files/* {
		header {
			X-Frame-Options SAMEORIGIN
		}
		request_body {
			max_size 20MB
		}
		reverse_proxy {$GARAGE_UPSTREAM}
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	# Phòng học trực tuyến: trình duyệt kết nối LiveKit qua wss://<domain>/rtc (cùng domain + chứng chỉ).
	# Media (WebRTC) đi thẳng tới máy LiveKit qua 7881/tcp, 7882/udp — không qua Caddy.
	handle /rtc* {
		reverse_proxy {$LIVEKIT_UPSTREAM}
	}

	# Trang công khai cho máy tìm kiếm / chia sẻ mạng xã hội (HTML do api dựng sẵn) + sitemap / robots.
	@seo path /p/* /sitemap.xml /robots.txt
	handle @seo {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv
		# File trong /assets có hash trong tên → cache lâu; index.html luôn hỏi lại để nhận bản mới.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"
		# SPA: đường dẫn không phải file thì trả index.html để Vue Router xử lý.
		try_files {path} /index.html
		file_server
	}
}
