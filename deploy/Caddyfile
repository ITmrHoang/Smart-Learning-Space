# Caddy: phục vụ frontend (file tĩnh) và chuyển /api/* sang service api.
# SITE_ADDRESS, API_UPSTREAM đặt trong deploy/docker-compose.yml (lấy từ deploy/.env).

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv
		# File trong /assets có hash trong tên → cache lâu; index.html luôn hỏi lại để nhận bản mới.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"
		# SPA: đường dẫn không phải file thì trả index.html để Vue Router xử lý.
		try_files {path} /index.html
		file_server
	}
}
