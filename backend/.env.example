# Cấu hình backend. Chép thành `.env` để chạy dev (giá trị dưới đây CHỈ dùng cho dev).
# Khớp với deploy/docker-compose.dev.yml.

BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://sls:sls_dev_password@127.0.0.1:5432/sls
VALKEY_URL=redis://127.0.0.1:6379
AMQP_URL=amqp://sls:sls_dev_password@127.0.0.1:5672/%2f

# Ít nhất 32 ký tự. Production: sinh ngẫu nhiên, không commit.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# Địa chỉ frontend (link trong email).
APP_BASE_URL=http://127.0.0.1:5173
# Để trống khi frontend gọi API qua proxy cùng origin (Vite dev / Caddy).
CORS_ORIGINS=
COOKIE_SECURE=false
TRUST_PROXY=false

# Admin đầu tiên: chỉ tạo khi hệ thống chưa có admin nào.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@sls.local
BOOTSTRAP_ADMIN_FULL_NAME="Quản trị viên"
BOOTSTRAP_ADMIN_PASSWORD=Admin12345

# Worker gửi email (dev: Mailpit, xem thư ở http://127.0.0.1:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Smart Learning Space <no-reply@sls.local>"

RUST_LOG=info,sqlx=warn
