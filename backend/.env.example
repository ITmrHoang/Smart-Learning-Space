# Cấu hình backend. Chép thành `.env` để chạy dev (giá trị dưới đây CHỈ dùng cho dev).
# Khớp với deploy/docker-compose.dev.yml.

BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://sls:sls_dev_password@127.0.0.1:5432/sls
VALKEY_URL=redis://127.0.0.1:6379
AMQP_URL=amqp://sls:sls_dev_password@127.0.0.1:5672/%2f

# Ít nhất 32 ký tự. Production: sinh ngẫu nhiên, không commit.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# Địa chỉ frontend (link trong email).
APP_BASE_URL=http://127.0.0.1:5173
# Để trống khi frontend gọi API qua proxy cùng origin (Vite dev / Caddy).
CORS_ORIGINS=
COOKIE_SECURE=false
TRUST_PROXY=false

# Admin đầu tiên: chỉ tạo khi hệ thống chưa có admin nào.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@sls.local
BOOTSTRAP_ADMIN_FULL_NAME="Quản trị viên"
BOOTSTRAP_ADMIN_PASSWORD=Admin12345

# Worker gửi email (dev: Mailpit, xem thư ở http://127.0.0.1:8025).
# Mailpit không có TLS. Production: starttls (cổng 587) hoặc tls (cổng 465), xem deploy/.env.example.
SMTP_TLS=none
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Smart Learning Space <no-reply@sls.local>"

RUST_LOG=info,sqlx=warn

# Số thiết bị đăng nhập cùng lúc tối đa của một tài khoản (0 = không giới hạn).
# Đăng nhập thiết bị mới thì thiết bị lâu không dùng nhất bị đăng xuất.
MAX_SESSIONS_PER_USER=2

# Đăng nhập Google / Microsoft (OIDC). Để trống = ẩn nút đăng nhập tương ứng.
# Redirect URI cần khai báo ở nhà cung cấp: {SSO_REDIRECT_BASE}/api/auth/sso/{google|microsoft}/callback
# (mặc định SSO_REDIRECT_BASE = APP_BASE_URL, dev: http://127.0.0.1:5173/api/auth/sso/google/callback).
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
# common (mọi loại tài khoản) | organizations (chỉ tài khoản trường / công ty) | consumers | <tenant id>
SSO_MICROSOFT_TENANT=common

# Lưu file trên Garage (S3). Dev: `docker compose -f deploy/docker-compose.dev.yml up -d` rồi
# `sh deploy/garage/init.sh` (một lần). Để trống S3_ENDPOINT = tắt upload file.
# Trình duyệt upload / tải thẳng với Garage qua {S3_PUBLIC_URL}/files/* (Vite / Caddy chuyển vào Garage).
S3_ENDPOINT=http://127.0.0.1:3900
S3_ACCESS_KEY_ID=GK736c732d6465762d6b657930
S3_SECRET_ACCESS_KEY=736c732d6465762d7365637265742d6b65792d30313233343536373839616263
S3_BUCKET=files
S3_REGION=garage
# Mặc định = APP_BASE_URL.
S3_PUBLIC_URL=

# Phòng học trực tuyến (LiveKit). Dev: docker compose -f deploy/docker-compose.dev.yml up -d (service livekit).
# Để trống LIVEKIT_API_KEY = chỉ dùng link họp ngoài. Khóa dev trùng deploy/livekit/livekit.dev.yaml.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=sls-dev
LIVEKIT_API_SECRET=736c732d6c6976656b69742d6465762d7365637265742d30313233343536
